{
  "name": "hl7-v2-fhir-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for the HL7 v2.5.1 to FHIR R4 crossing — field, datatype and code-value mappings, plus whole-message conversion of ORM, ADT and ORU into a FHIR transaction Bundle, with a warning for every value it cannot map faithfully.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "hl7-v2-fhir-mcp-server": "server.js"
  },
  "files": [
    "server.js"
  ],
  "scripts": {
    "start": "node server.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "hl7",
    "hl7-v2",
    "fhir",
    "fhir-r4",
    "healthcare",
    "interoperability",
    "v2-to-fhir",
    "radiology"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coffeemilktea/hl7-v2-fhir-mcp-server.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  }
}
